{"nodes": [{"id": "readme_document", "label": "Telegram Emoji, Sticker & AI Studio Bot README", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bot", "label": "Telegram Emoji, Sticker & AI Studio Bot 1.1 \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_aiogram", "label": "aiogram asynchronous private-chat long polling \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_stars", "label": "Telegram Stars (XTR) digital-goods payments \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_sqlalchemy", "label": "SQLAlchemy persistence \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_sqlite", "label": "SQLite WAL default storage \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_postgresql", "label": "PostgreSQL asyncpg support \u2014 deployment smoke tests outstanding", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "supported_not_live_validated"}, {"id": "readme_localization", "label": "Turkish, English and German interfaces \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Initial Telegram language sets the locale; unsupported languages fall back to Turkish; manual choices persist."}, {"id": "readme_emoji_pack", "label": "Direct custom emoji splitter \u2014 implemented, 2\u00d72\u20138\u00d78", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "free_allowance": 3, "price_xtr": 50}, {"id": "readme_face_censorship", "label": "Face pixelation or 51\u00d751 blur \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "lifetime_free_allowance": 5, "daily_free_allowance": 1, "price_xtr": 20, "rationale": "Haar face detection changes only detected rectangles, retaining source dimensions and alpha; detection can miss small or profile faces."}, {"id": "readme_ai_studio", "label": "AI Grid Studio \u2014 implemented, 1\u00d71\u20139\u00d79", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "free_allowance": 1, "price_xtr": 100, "rationale": "Blueprints and prompts are free; both output formats share the Studio lifetime allowance. Artwork generation is external, not an integrated AI API call."}, {"id": "readme_separate_quota_pools", "label": "Three independent service quota pools \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Direct emoji, face censorship and Studio cannot consume each other's free allowance."}, {"id": "readme_utc_daily_credit", "label": "Non-accumulating UTC daily photo credit \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Reset lazily on first interaction after 00:00 UTC and consume daily credit before lifetime credit. A previous day's failed reservation cannot add an extra current-day credit."}, {"id": "readme_atomic_credit_reservation", "label": "Atomic quota reservation and job insertion \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "One database transaction reserves credit and creates the job. Invalid images and no-face inputs do not reserve credit or generate invoices."}, {"id": "readme_blueprint", "label": "1024\u00d71024 PNG grid blueprint \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Dashed boundaries, A1\u2013I9 coordinates, numbered cells and checkerboard guide expose the intended sprite layout."}, {"id": "readme_generation_prompt", "label": "Localized copyable generation prompt with subject slot \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_external_generation", "label": "User-run external artwork generation \u2014 current Studio workflow", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented_external_user_step", "rationale": "The user generates and uploads a sheet. The bot requires no AI API key, does not call generators and cannot guarantee their cell alignment."}, {"id": "readme_custom_emoji_output", "label": "Studio custom emoji output \u2014 implemented, 100\u00d7100 PNG", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_regular_sticker_output", "label": "Studio regular sticker output \u2014 implemented, 512\u00d7512 PNG", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented"}, {"id": "readme_slicing", "label": "Center-cropped row-major sprite slicing \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Existing alpha is preserved and white backgrounds remain white. Direct emoji output uses lossless 100\u00d7100 WebP."}, {"id": "readme_png_size_budget", "label": "512 KiB PNG upload budget with palette reduction \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Oversized Studio PNG tiles use a palette with transparent colors to fit static-sticker upload limits."}, {"id": "readme_pack_creation", "label": "Branded Telegram emoji and sticker set creation \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Titles end in ' \u2022 by @bot_username', slugs end in '_by_bot_username', and URLs match the chosen output type."}, {"id": "readme_sticker_batching", "label": "50 initial stickers then append remaining tiles \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Telegram limits initial set creation to 50 entries. The 81-tile Studio flow appends 31; the 64-tile direct flow appends 14. Identical stickers may be merged by Telegram."}, {"id": "readme_bounded_processing", "label": "Worker threads with bounded image processing pool \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Drawing and slicing share bounded CPU slots; upload/pixel limits constrain decoded memory. Blueprints stream from memory."}, {"id": "readme_input_fsm", "label": "MemoryStorage input FSM with metadata-only uploads \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Selection state is ephemeral across restart, while prepared media and paid work are durable; raw image bytes are not kept in FSM or logs."}, {"id": "readme_bound_format_buttons", "label": "Studio format buttons bound to the uploaded image \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Old buttons cannot submit a replacement image."}, {"id": "readme_checkout_validation", "label": "Owner-bound checkout validation with 7.5-second DB timeout \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Checks owner, XTR amount, terms, status, media and expiry; bypasses CPU and flow locks to meet Telegram's 10-second deadline."}, {"id": "readme_payment_idempotency", "label": "Unique-charge payment and quota idempotency \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Repeat payment updates do not repeat completed operations or consume more quota; additional charges for one job are refunded."}, {"id": "readme_payment_inbox", "label": "Durable successful-payment inbox \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Persist updates before advancing Telegram polling offset, then replay unrecorded payments independent of FSM state."}, {"id": "readme_job_recovery", "label": "Restart recovery for prepared jobs, assets and refunds \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Persist job state, sticker file IDs, deterministic pack names and pending refunds so unfinished work survives process restart."}, {"id": "readme_retry_and_refunds", "label": "Network retries, rate-limit scheduling and persistent refunds \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Network/server errors retry three times after the initial attempt; retry_after governs rate limits. Permanent failures restore free credit or queue a Stars refund, whose failures retry durably."}, {"id": "readme_at_least_once_delivery", "label": "At-least-once result delivery \u2014 explicit current limitation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented_limitation", "rationale": "Telegram sendDocument/sendMessage lack an idempotency key; crashes before local completion commits can redeliver an already sent result, despite idempotent payments and quota accounting."}, {"id": "readme_media_retention", "label": "Prepared-media expiry, cleanup and retained support records \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "Prepared media are deleted after success/failure or expiry; approved invoices retain media an extra 24 hours for delayed payments. Metadata and receipts remain for support; Telegram retains uploaded copies."}, {"id": "readme_single_instance", "label": "Single-instance polling deployment with filesystem lock \u2014 implemented", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented", "rationale": "One process per token/data directory. Scaling to multiple instances needs distributed leases, shared media and a shared FSM."}, {"id": "readme_studio_migration", "label": "Idempotent 1.1 free_ai_studio_credits migration \u2014 implemented", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "status": "implemented_not_applied_to_workspace_runtime_db", "rationale": "Existing users get one Studio credit once; previous quotas, language, jobs and payments persist. create_all alone cannot add columns."}, {"id": "readme_simulated_validation", "labe