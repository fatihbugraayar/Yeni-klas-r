{"nodes": [{"id": "readme_telegram_emoji_photo_editor_bot", "label": "Telegram Emoji & Photo Editor Bot", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_aiogram", "label": "aiogram", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_emoji_pack_generation", "label": "Custom emoji pack generation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Square crop and row-major 100\u00d7100 lossless WebP tiles preserve alpha; 8\u00d78 packs require 50 initial stickers plus 14 appended stickers."}, {"id": "readme_face_censorship", "label": "OpenCV face censorship", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only detected rectangles are blurred or pixelated; PNG document delivery avoids further Telegram compression while preserving source dimensions and alpha."}, {"id": "readme_opencv_haar_cascade", "label": "OpenCV frontal-face Haar cascade", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_telegram_sticker_api", "label": "Telegram sticker API", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_telegram_stars", "label": "Telegram Stars", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stars_integration_guide", "label": "Telegram Stars integration guide", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sqlalchemy_persistence", "label": "SQLAlchemy persistence", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_localization", "label": "Turkish / English / German localization", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Initial Telegram language selects the interface; unsupported languages fall back to Turkish and manual choices persist."}, {"id": "readme_credit_reservation", "label": "Transactional credit reservation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credit reservation and job insertion share a transaction to preserve quota accounting; invalid inputs and images with no faces consume no credit."}, {"id": "readme_daily_photo_credit", "label": "UTC daily photo credit", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily credit resets lazily after 00:00 UTC, never accumulates, and is consumed before lifetime credit; a previous day's restored reservation cannot create extra current-day credit."}, {"id": "readme_checkout_validation", "label": "Pre-checkout validation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 7.5-second database timeout leaves time for Telegram's 10-second response deadline; validation bypasses CPU work and input-flow locks."}, {"id": "readme_payment_idempotency", "label": "Idempotent payment accounting", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique charge IDs prevent repeated quota consumption or completed operations; additional charges for the same job are refunded."}, {"id": "readme_durable_payment_inbox", "label": "Durable payment inbox", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisting successful-payment updates before advancing Telegram's update offset allows a recovery loop to replay unrecorded payments."}, {"id": "readme_job_recovery", "label": "Persisted job recovery", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisted jobs, prepared assets, uploaded sticker IDs, deterministic pack names and pending refunds survive restarts independently of conversational FSM state."}, {"id": "readme_memory_storage", "label": "MemoryStorage conversational FSM", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_retry_refund_handling", "label": "Retry and refund handling", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network/server failures get three retries after the initial attempt, rate limits honor retry_after, and permanent failures restore free credit or queue refunds."}, {"id": "readme_at_least_once_delivery", "label": "At-least-once result delivery", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Telegram sendDocument/sendMessage lack idempotency keys, so crashes or ambiguous network timeouts can duplicate delivery before the local completion commit."}, {"id": "readme_media_retention", "label": "Prepared-media retention", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prepared images are deleted after completion or failure; unpaid invoices expire after 60 minutes by default, approved checkout assets receive 24 extra hours, and late charges are refunded."}, {"id": "readme_single_instance_polling", "label": "Single-instance long polling", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One process per token and data directory is required; multi-instance operation needs distributed leases, shared media storage and shared FSM."}, {"id": "readme_filesystem_lock", "label": "Local filesystem runtime lock", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A local lock prevents accidental concurrent workers sharing the data directory."}, {"id": "readme_sqlite_wal", "label": "SQLite with WAL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_postgresql", "label": "PostgreSQL via asyncpg", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_explicit_schema_migrations", "label": "Explicit schema migrations", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startup create_all creates a new schema but cannot migrate columns in existing databases."}, {"id": "readme_bounded_concurrency", "label": "Bounded update and CPU concurrency", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polling admits 64 updates, CPU concurrency defaults to 2, and separate preparation/delivery pools limit resource usage because decoded images can exceed compressed input size."}, {"id": "readme_simulated_api_tests", "label": "SQLite and simulated Telegram API tests", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_deployment_smoke_tests", "label": "Live deployment smoke tests", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live Telegram uploads, Stars settlement, PostgreSQL and Docker require separate configured smoke tests; no live payments were made."}], "edges": [{"source": "readme_telegram_emoji_photo_editor_bot", "target": "readme_aiogram", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.md", "source_location": null, "weight": 1}, {"source": "readme_telegram_emoji_photo_editor_bot", "target": "readme_emoji_pack_generation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.md", "source_location": null, "weight": 1}, {"source": "readme_telegram_emoji_photo_editor_bot", "target": "readme_face_censorship", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "README.md", "source_location": null, "weight": 1}, {"source": "readme_telegram_emoji_photo_editor_bot", "target": "readme_